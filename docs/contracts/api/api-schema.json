{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SentriAI Mini REST API Schema Foundation",
  "description": "JSON Schema definition for all REST API endpoints and data models in SentriAI Mini (CR-002)",
  "version": "1.0.0",
  "definitions": {
    "ResponseEnvelope": {
      "type": "object",
      "required": ["success", "data", "error", "meta"],
      "properties": {
        "success": {
          "type": "boolean",
          "description": "Trạng thái thành công của API call"
        },
        "data": {
          "description": "Dữ liệu trả về (Generic T hoặc null khi thất bại)"
        },
        "error": {
          "oneOf": [
            { "$ref": "#/definitions/ErrorPayload" },
            { "type": "null" }
          ]
        },
        "meta": {
          "$ref": "#/definitions/MetaPayload"
        }
      }
    },
    "MetaPayload": {
      "type": "object",
      "required": ["timestamp", "request_id"],
      "properties": {
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "request_id": {
          "type": "string"
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "limit": {
          "type": "integer",
          "minimum": 1
        },
        "total_items": {
          "type": "integer",
          "minimum": 0
        },
        "total_pages": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "ErrorPayload": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "BAD_REQUEST",
            "UNAUTHORIZED",
            "FORBIDDEN",
            "NOT_FOUND",
            "INVALID_ZONE_POLYGON",
            "COOLDOWN_ACTIVE",
            "INTERNAL_SERVER_ERROR",
            "AI_MODEL_UNAVAILABLE"
          ]
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "field": { "type": "string" },
              "issue": { "type": "string" }
            }
          }
        }
      }
    },
    "Camera": {
      "type": "object",
      "required": ["id", "name", "location", "stream_url", "status", "fps"],
      "properties": {
        "id": {
          "type": "string",
          "enum": ["GATE-01", "BAI-KIEM"]
        },
        "name": { "type": "string" },
        "location": { "type": "string" },
        "stream_url": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["online", "offline", "degraded"]
        },
        "fps": { "type": "number", "minimum": 0 }
      }
    },
    "Point2D": {
      "type": "object",
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number", "description": "Tọa độ X chuẩn hóa từ 0.0 đến 1.0 hoặc điểm pixel" },
        "y": { "type": "number", "description": "Tọa độ Y chuẩn hóa từ 0.0 đến 1.0 hoặc điểm pixel" }
      }
    },
    "Zone": {
      "type": "object",
      "required": ["id", "camera_id", "name", "vertices", "allowed_classes", "forbidden_classes", "is_active"],
      "properties": {
        "id": { "type": "string" },
        "camera_id": { "type": "string" },
        "name": { "type": "string" },
        "vertices": {
          "type": "array",
          "items": { "$ref": "#/definitions/Point2D" },
          "minItems": 3
        },
        "allowed_classes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "forbidden_classes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "is_active": { "type": "boolean" },
        "color": { "type": "string", "default": "#EF4444" }
      }
    },
    "Vehicle": {
      "type": "object",
      "required": ["id", "license_plate", "vehicle_type", "tag_label", "last_seen_at", "total_entries"],
      "properties": {
        "id": { "type": "string" },
        "license_plate": { "type": "string" },
        "vehicle_type": { "type": "string" },
        "tag_label": {
          "type": "string",
          "enum": ["known", "unknown", "blacklisted"]
        },
        "crop_image_url": { "type": "string" },
        "last_seen_at": { "type": "string", "format": "date-time" },
        "total_entries": { "type": "integer", "minimum": 0 }
      }
    },
    "Event": {
      "type": "object",
      "required": [
        "id",
        "timestamp",
        "camera_id",
        "event_type",
        "severity_level",
        "object_class",
        "confidence"
      ],
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "camera_id": { "type": "string" },
        "zone_id": { "type": "string" },
        "lane_id": { "type": "string" },
        "event_type": {
          "type": "string",
          "enum": ["LPR_PASSAGE", "ZONE_VIOLATION", "RESTRICTED_ACCESS"]
        },
        "severity_level": {
          "type": "integer",
          "enum": [1, 2, 3],
          "description": "1: Green (Xe quen/Hợp lệ), 2: Yellow (Xe lạ/Chú ý), 3: Red (Vi phạm zone)"
        },
        "license_plate": { "type": "string" },
        "object_class": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1.0 },
        "bbox": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 4,
          "maxItems": 4,
          "description": "[x_min, y_min, x_max, y_max]"
        },
        "crop_image_url": { "type": "string" },
        "video_clip_url": { "type": "string" }
      }
    },
    "CustomLabel": {
      "type": "object",
      "required": ["id", "label_name", "category", "sample_count", "updated_at"],
      "properties": {
        "id": { "type": "string" },
        "label_name": { "type": "string" },
        "category": { "type": "string", "enum": ["person", "vehicle", "equipment", "custom"] },
        "sample_count": { "type": "integer", "minimum": 0 },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    },
    "ChatbotQueryRequest": {
      "type": "object",
      "required": ["query_text"],
      "properties": {
        "query_text": { "type": "string" }
      }
    },
    "ChatbotQueryResponse": {
      "type": "object",
      "required": ["answer_text", "total_records"],
      "properties": {
        "answer_text": { "type": "string" },
        "total_records": { "type": "integer", "minimum": 0 },
        "sql_query": { "type": "string" },
        "evidence_video_url": { "type": "string" },
        "evidence_event": { "$ref": "#/definitions/Event" },
        "prompt_chips": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "KpiStats": {
      "type": "object",
      "required": [
        "gate_vehicles_total",
        "gate_lpr_success",
        "gate_lpr_failed",
        "gate_avg_confidence",
        "area_active_objects",
        "area_zone_violations",
        "area_active_machinery",
        "area_total_zones"
      ],
      "properties": {
        "gate_vehicles_total": { "type": "integer", "minimum": 0 },
        "gate_lpr_success": { "type": "integer", "minimum": 0 },
        "gate_lpr_failed": { "type": "integer", "minimum": 0 },
        "gate_avg_confidence": { "type": "number", "minimum": 0, "maximum": 100.0 },
        "area_active_objects": { "type": "integer", "minimum": 0 },
        "area_zone_violations": { "type": "integer", "minimum": 0 },
        "area_active_machinery": { "type": "integer", "minimum": 0 },
        "area_total_zones": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
