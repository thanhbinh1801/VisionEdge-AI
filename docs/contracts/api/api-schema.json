{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SentriAI Mini REST API Schema Foundation (CR-001 & CR-002)",
  "description": "JSON Schema definition for all REST API endpoints, schemas, and data models in SentriAI Mini",
  "version": "1.1.0",
  "definitions": {
    "ResponseEnvelope": {
      "type": "object",
      "required": ["success", "data", "error", "meta"],
      "properties": {
        "success": {
          "type": "boolean",
          "description": "Trạng thái thành công của API call"
        },
        "data": {
          "description": "Dữ liệu trả về (Generic T hoặc null khi thất bại)"
        },
        "error": {
          "oneOf": [
            { "$ref": "#/definitions/ErrorPayload" },
            { "type": "null" }
          ]
        },
        "meta": {
          "$ref": "#/definitions/MetaPayload"
        }
      }
    },
    "MetaPayload": {
      "type": "object",
      "required": ["timestamp", "request_id"],
      "properties": {
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "request_id": {
          "type": "string"
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "limit": {
          "type": "integer",
          "minimum": 1
        },
        "total_items": {
          "type": "integer",
          "minimum": 0
        },
        "total_pages": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "ErrorPayload": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "BAD_REQUEST",
            "UNAUTHORIZED",
            "FORBIDDEN",
            "NOT_FOUND",
            "INVALID_ZONE_POLYGON",
            "COOLDOWN_ACTIVE",
            "INTERNAL_SERVER_ERROR",
            "AI_MODEL_UNAVAILABLE"
          ]
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "field": { "type": "string" },
              "issue": { "type": "string" }
            }
          }
        }
      }
    },
    "ObjectTypeEnum": {
      "type": "string",
      "enum": [
        "container",
        "truck",
        "forklift",
        "crane",
        "car",
        "motorbike",
        "bicycle",
        "person"
      ],
      "description": "8 loại đối tượng/phương tiện được phân loại theo quy tắc CR-001"
    },
    "VehicleTagLabelEnum": {
      "type": "string",
      "enum": ["known", "unknown"],
      "description": "Nhãn phân định Xe quen (đã xác thực/hợp lệ) hoặc Xe lạ (chưa ghi nhận/cần chú ý)"
    },
    "Camera": {
      "type": "object",
      "required": ["id", "name", "location", "stream_url", "status", "fps"],
      "properties": {
        "id": {
          "type": "string",
          "enum": ["GATE-01", "BAI-KIEM"]
        },
        "name": { "type": "string" },
        "location": { "type": "string" },
        "stream_url": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["online", "offline", "degraded"]
        },
        "fps": { "type": "number", "minimum": 0 }
      }
    },
    "Point2D": {
      "type": "object",
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number", "description": "Tọa độ X tương đối (0.0 - 100.0) trên Canvas SVG" },
        "y": { "type": "number", "description": "Tọa độ Y tương đối (0.0 - 100.0) trên Canvas SVG" }
      }
    },
    "Zone": {
      "type": "object",
      "required": ["id", "camera_id", "name", "vertices", "allowed_object_types", "prohibited_object_types", "is_active"],
      "properties": {
        "id": { "type": "string" },
        "camera_id": { "type": "string", "enum": ["BAI-KIEM", "GATE-01"] },
        "name": { "type": "string" },
        "vertices": {
          "type": "array",
          "items": { "$ref": "#/definitions/Point2D" },
          "minItems": 3,
          "description": "Danh sách đỉnh đa giác SVG 4 thao tác (thêm góc, kéo đỉnh, kéo điểm giữa cạnh, kéo thân)"
        },
        "allowed_object_types": {
          "type": "array",
          "items": { "$ref": "#/definitions/ObjectTypeEnum" },
          "description": "Danh sách các loại xe/đối tượng ĐƯỢC PHÉP vào zone (Tick ✓)"
        },
        "prohibited_object_types": {
          "type": "array",
          "items": { "$ref": "#/definitions/ObjectTypeEnum" },
          "description": "Danh sách các loại xe/đối tượng BỊ CẤM vào zone (Tick ✕)"
        },
        "is_active": { "type": "boolean" },
        "color": { "type": "string", "default": "#EF4444" }
      }
    },
    "Vehicle": {
      "type": "object",
      "required": ["id", "license_plate", "vehicle_type", "tag_label", "last_seen_at", "total_entries"],
      "properties": {
        "id": { "type": "string" },
        "license_plate": { "type": "string" },
        "vehicle_type": { "$ref": "#/definitions/ObjectTypeEnum" },
        "tag_label": { "$ref": "#/definitions/VehicleTagLabelEnum" },
        "crop_image_url": { "type": "string" },
        "last_seen_at": { "type": "string", "format": "date-time" },
        "total_entries": { "type": "integer", "minimum": 0 },
        "notes": { "type": "string" }
      }
    },
    "Event": {
      "type": "object",
      "required": [
        "id",
        "timestamp",
        "camera_id",
        "event_type",
        "severity_level",
        "object_class",
        "confidence"
      ],
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "camera_id": { "type": "string" },
        "zone_id": { "type": "string" },
        "lane_id": { "type": "string" },
        "event_type": {
          "type": "string",
          "enum": ["LPR_PASSAGE", "ZONE_VIOLATION", "RESTRICTED_ACCESS"]
        },
        "severity_level": {
          "type": "integer",
          "enum": [1, 2, 3],
          "description": "1: Green (Xe quen/Hợp lệ), 2: Yellow (Xe lạ/Chú ý), 3: Red (Vi phạm zone cấm)"
        },
        "license_plate": { "type": "string" },
        "vehicle_label": { "$ref": "#/definitions/VehicleTagLabelEnum" },
        "object_class": { "$ref": "#/definitions/ObjectTypeEnum" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1.0 },
        "bbox": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 4,
          "maxItems": 4,
          "description": "[x_min, y_min, x_max, y_max]"
        },
        "crop_image_url": { "type": "string" },
        "video_clip_url": { "type": "string" }
      }
    },
    "CustomLabel": {
      "type": "object",
      "required": ["id", "label_name", "category", "sample_count", "updated_at"],
      "properties": {
        "id": { "type": "string" },
        "label_name": { "type": "string" },
        "category": { "type": "string", "enum": ["person", "vehicle_shape"] },
        "sample_count": { "type": "integer", "minimum": 0 },
        "updated_at": { "type": "string", "format": "date-time" }
      }
    },
    "DatasetSource": {
      "type": "object",
      "required": ["id", "name", "kind", "url"],
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "kind": { "type": "string", "enum": ["img", "video"] },
        "url": { "type": "string" },
        "duration_seconds": { "type": "number" },
        "total_frames": { "type": "integer" }
      }
    },
    "BBoxSample": {
      "type": "object",
      "required": ["id", "label_id", "source_id", "x", "y", "w", "h", "category"],
      "properties": {
        "id": { "type": "string" },
        "label_id": { "type": "string" },
        "source_id": { "type": "string" },
        "frame_index": { "type": "integer" },
        "x": { "type": "number", "description": "Tọa độ góc trái X (%)" },
        "y": { "type": "number", "description": "Tọa độ góc trên Y (%)" },
        "w": { "type": "number", "description": "Chiều rộng BBox (%)" },
        "h": { "type": "number", "description": "Chiều cao BBox (%)" },
        "category": { "type": "string", "enum": ["person", "vehicle_shape"] },
        "label_name": { "type": "string" },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "BBoxBatchSaveRequest": {
      "type": "object",
      "required": ["samples"],
      "properties": {
        "samples": {
          "type": "array",
          "items": { "$ref": "#/definitions/BBoxSample" }
        }
      }
    },
    "DatasetSyncZonesResponse": {
      "type": "object",
      "required": ["synced_count", "synced_labels", "affected_zones"],
      "properties": {
        "synced_count": { "type": "integer" },
        "synced_labels": {
          "type": "array",
          "items": { "type": "string" }
        },
        "affected_zones": { "type": "integer" }
      }
    },
    "ChatbotQueryRequest": {
      "type": "object",
      "required": ["query_text"],
      "properties": {
        "query_text": { "type": "string" }
      }
    },
    "ChatbotQueryResponse": {
      "type": "object",
      "required": ["answer_text", "total_records"],
      "properties": {
        "answer_text": { "type": "string" },
        "total_records": { "type": "integer", "minimum": 0 },
        "sql_query": { "type": "string" },
        "evidence_video_url": { "type": "string" },
        "evidence_event": { "$ref": "#/definitions/Event" },
        "prompt_chips": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "KpiStats": {
      "type": "object",
      "required": [
        "gate_vehicles_total",
        "gate_lpr_success",
        "gate_lpr_failed",
        "gate_avg_confidence",
        "area_active_objects",
        "area_zone_violations",
        "area_active_machinery",
        "area_total_zones"
      ],
      "properties": {
        "gate_vehicles_total": { "type": "integer", "minimum": 0 },
        "gate_lpr_success": { "type": "integer", "minimum": 0 },
        "gate_lpr_failed": { "type": "integer", "minimum": 0 },
        "gate_avg_confidence": { "type": "number", "minimum": 0, "maximum": 100.0 },
        "area_active_objects": { "type": "integer", "minimum": 0 },
        "area_zone_violations": { "type": "integer", "minimum": 0 },
        "area_active_machinery": { "type": "integer", "minimum": 0 },
        "area_total_zones": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
