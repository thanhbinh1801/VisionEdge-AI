{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SentriAI Mini WebSocket Real-time Event Specification",
  "version": "1.0.0",
  "events": {
    "EVENT_NEW_DETECTION": {
      "description": "Dispatched in real-time when a camera frame triggers an LPR or Zone event",
      "payload": {
        "type": "object",
        "properties": {
          "event_id": { "type": "string" },
          "camera_id": { "type": "string" },
          "severity": { "type": "integer", "enum": [1, 2, 3] },
          "license_plate": { "type": "string" },
          "ocr_confidence": { "type": "number" },
          "object_class": { "type": "string" },
          "zone_id": { "type": "string" },
          "snapshot_url": { "type": "string" },
          "clip_url": { "type": "string" },
          "timestamp": { "type": "string", "format": "date-time" }
        },
        "required": ["event_id", "camera_id", "severity", "timestamp"]
      }
    },
    "EVENT_ALERT_BEEP": {
      "description": "Triggered specifically for Severity Level 3 events requiring audio beep on Web UI and Telegram notification",
      "payload": {
        "type": "object",
        "properties": {
          "event_id": { "type": "string" },
          "severity": { "type": "integer", "const": 3 },
          "alert_title": { "type": "string" },
          "alert_message": { "type": "string" },
          "telegram_sent": { "type": "boolean" },
          "timestamp": { "type": "string", "format": "date-time" }
        },
        "required": ["event_id", "severity", "alert_title", "timestamp"]
      }
    }
  }
}
