{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SentriAI Mini WebSocket Event Schemas Draft for TASK-016",
  "description": "Draft additive WebSocket contract alignment for AREA_FRAME_METADATA under CR-003",
  "version": "1.2.0-task016-draft",
  "draft_metadata": {
    "task_id": "TASK-016",
    "generated_at": "2026-08-20T18:50:16+07:00",
    "source_contract": ".delivery/tasks/TASK-016/API-CONTRACT.md",
    "intended_target": "docs/contracts/api/websocket-events.json",
    "notes": [
      "Draft only; do not promote outside TASK-016 without owner review.",
      "AREA_FRAME_METADATA remains additive in v1."
    ]
  },
  "type": "object",
  "required": ["event_type", "timestamp", "payload"],
  "properties": {
    "event_type": {
      "type": "string",
      "enum": [
        "LPR_DETECTION_EVENT",
        "ZONE_VIOLATION_EVENT",
        "AREA_FRAME_METADATA",
        "KPI_STATS_UPDATE",
        "ALERT_LEVEL_3_NOTIFICATION",
        "DATASET_SAMPLE_SYNC_EVENT"
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "payload": {
      "oneOf": [
        {
          "$ref": "#/definitions/LprDetectionPayload"
        },
        {
          "$ref": "#/definitions/ZoneViolationPayload"
        },
        {
          "$ref": "#/definitions/AreaFrameMetadataPayload"
        },
        {
          "$ref": "#/definitions/KpiStatsUpdatePayload"
        },
        {
          "$ref": "#/definitions/AlertLevel3Payload"
        },
        {
          "$ref": "#/definitions/DatasetSampleSyncPayload"
        }
      ]
    }
  },
  "definitions": {
    "ObjectClass": {
      "type": "string",
      "enum": ["container", "truck", "forklift", "crane", "car", "motorbike", "bicycle", "person"]
    },
    "ZoneRuleResult": {
      "type": "string",
      "enum": ["allowed", "prohibited", "observed"]
    },
    "NormalizedBBox": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "minItems": 4,
      "maxItems": 4
    },
    "NormalizedPoint2D": {
      "type": "object",
      "required": ["x", "y"],
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "LprDetectionPayload": {
      "type": "object",
      "required": ["event_id", "camera_id", "lane_id", "license_plate", "confidence", "tag_label", "crop_image_url", "video_clip_url"],
      "properties": {
        "event_id": {
          "type": "string"
        },
        "camera_id": {
          "type": "string",
          "enum": ["GATE-01"]
        },
        "lane_id": {
          "type": "string",
          "enum": ["IN_1", "IN_2"]
        },
        "license_plate": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "tag_label": {
          "type": "string",
          "enum": ["known", "unknown"]
        },
        "severity_level": {
          "type": "integer",
          "enum": [1, 2]
        },
        "crop_image_url": {
          "type": "string"
        },
        "video_clip_url": {
          "type": "string"
        }
      }
    },
    "ZoneViolationPayload": {
      "type": "object",
      "required": ["event_id", "camera_id", "zone_id", "zone_name", "object_class", "severity_level", "crop_image_url", "video_clip_url"],
      "properties": {
        "event_id": {
          "type": "string"
        },
        "camera_id": {
          "type": "string",
          "enum": ["BAI-KIEM"]
        },
        "zone_id": {
          "type": "string"
        },
        "zone_name": {
          "type": "string"
        },
        "object_class": {
          "$ref": "#/definitions/ObjectClass"
        },
        "vehicle_label": {
          "type": "string",
          "enum": ["known", "unknown"]
        },
        "bbox": {
          "$ref": "#/definitions/NormalizedBBox"
        },
        "severity_level": {
          "type": "integer",
          "enum": [1, 2, 3]
        },
        "crop_image_url": {
          "type": "string"
        },
        "video_clip_url": {
          "type": "string"
        }
      }
    },
    "AreaFrameMetadataPayload": {
      "type": "object",
      "required": [
        "camera_id",
        "frame_id",
        "captured_at",
        "zone_version",
        "stream_status",
        "pipeline_latency_ms",
        "objects",
        "kpi_delta"
      ],
      "properties": {
        "camera_id": {
          "type": "string",
          "enum": ["BAI-KIEM"]
        },
        "frame_id": {
          "type": "string"
        },
        "captured_at": {
          "type": "string",
          "format": "date-time"
        },
        "zone_version": {
          "type": "integer",
          "minimum": 1
        },
        "stream_status": {
          "type": "string",
          "enum": ["online", "degraded", "offline"]
        },
        "pipeline_latency_ms": {
          "type": "number",
          "minimum": 0
        },
        "objects": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["track_id", "object_class", "confidence", "bbox", "center_point", "zone_hits"],
            "properties": {
              "track_id": {
                "type": "string"
              },
              "object_class": {
                "$ref": "#/definitions/ObjectClass"
              },
              "confidence": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "bbox": {
                "$ref": "#/definitions/NormalizedBBox"
              },
              "center_point": {
                "$ref": "#/definitions/NormalizedPoint2D"
              },
              "zone_hits": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["zone_id", "zone_name", "rule_result"],
                  "properties": {
                    "zone_id": {
                      "type": "string"
                    },
                    "zone_name": {
                      "type": "string"
                    },
                    "rule_result": {
                      "$ref": "#/definitions/ZoneRuleResult"
                    }
                  }
                }
              }
            }
          }
        },
        "kpi_delta": {
          "type": "object",
          "required": [
            "area_active_objects",
            "area_zone_violations",
            "area_active_machinery",
            "area_total_zones"
          ],
          "properties": {
            "area_active_objects": {
              "type": "integer",
              "minimum": 0
            },
            "area_zone_violations": {
              "type": "integer",
              "minimum": 0
            },
            "area_active_machinery": {
              "type": "integer",
              "minimum": 0
            },
            "area_total_zones": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "stream_status": {
                "const": "offline"
              }
            },
            "required": ["stream_status"]
          },
          "then": {
            "properties": {
              "objects": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "KpiStatsUpdatePayload": {
      "type": "object",
      "required": [
        "gate_vehicles_total",
        "gate_lpr_success",
        "gate_lpr_failed",
        "gate_avg_confidence",
        "area_active_objects",
        "area_zone_violations",
        "area_active_machinery",
        "area_total_zones"
      ],
      "properties": {
        "gate_vehicles_total": {
          "type": "integer",
          "minimum": 0
        },
        "gate_lpr_success": {
          "type": "integer",
          "minimum": 0
        },
        "gate_lpr_failed": {
          "type": "integer",
          "minimum": 0
        },
        "gate_avg_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "area_active_objects": {
          "type": "integer",
          "minimum": 0
        },
        "area_zone_violations": {
          "type": "integer",
          "minimum": 0
        },
        "area_active_machinery": {
          "type": "integer",
          "minimum": 0
        },
        "area_total_zones": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "AlertLevel3Payload": {
      "type": "object",
      "required": ["alert_id", "timestamp", "camera_id", "zone_name", "violation_reason", "crop_image_url", "audio_trigger"],
      "properties": {
        "alert_id": {
          "type": "string"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "camera_id": {
          "type": "string"
        },
        "zone_name": {
          "type": "string"
        },
        "violation_reason": {
          "type": "string"
        },
        "crop_image_url": {
          "type": "string"
        },
        "audio_trigger": {
          "type": "boolean",
          "default": true
        },
        "telegram_dispatched": {
          "type": "boolean"
        }
      }
    },
    "DatasetSampleSyncPayload": {
      "type": "object",
      "required": ["sync_id", "timestamp", "new_labels", "synced_zones_count"],
      "properties": {
        "sync_id": {
          "type": "string"
        },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "new_labels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "synced_zones_count": {
          "type": "integer"
        }
      }
    }
  }
}
