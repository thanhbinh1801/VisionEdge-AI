{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SentriAI Mini REST API Schema Foundation Draft for TASK-016",
  "description": "Draft additive updates for control-plane zone cache semantics and area metadata payload alignment",
  "version": "1.2.0-task016-draft",
  "draft_metadata": {
    "task_id": "TASK-016",
    "generated_at": "2026-08-20T18:50:16+07:00",
    "source_contract": ".delivery/tasks/TASK-016/API-CONTRACT.md",
    "intended_target": "docs/contracts/api/api-schema.json",
    "notes": [
      "Draft only; do not promote outside TASK-016 without owner review.",
      "Changes are additive refinements aligned to CR-003."
    ]
  },
  "definitions": {
    "ApiErrorCode": {
      "type": "string",
      "enum": [
        "BAD_REQUEST",
        "UNAUTHORIZED",
        "FORBIDDEN",
        "NOT_FOUND",
        "INVALID_ZONE_POLYGON",
        "COOLDOWN_ACTIVE",
        "ZONE_CACHE_REFRESH_FAILED",
        "CONFLICTING_ZONE_RULES",
        "INTERNAL_SERVER_ERROR",
        "AI_MODEL_UNAVAILABLE"
      ]
    },
    "ResponseEnvelope": {
      "type": "object",
      "required": ["success", "data", "error", "meta"],
      "properties": {
        "success": {
          "type": "boolean"
        },
        "data": {},
        "error": {
          "oneOf": [
            {
              "$ref": "#/definitions/ErrorPayload"
            },
            {
              "type": "null"
            }
          ]
        },
        "meta": {
          "$ref": "#/definitions/MetaPayload"
        }
      }
    },
    "MetaPayload": {
      "type": "object",
      "required": ["timestamp", "request_id"],
      "properties": {
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "request_id": {
          "type": "string"
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "limit": {
          "type": "integer",
          "minimum": 1
        },
        "total_items": {
          "type": "integer",
          "minimum": 0
        },
        "total_pages": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "ErrorPayload": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": {
          "$ref": "#/definitions/ApiErrorCode"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["field", "issue"],
            "properties": {
              "field": {
                "type": "string"
              },
              "issue": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "ObjectTypeEnum": {
      "type": "string",
      "enum": [
        "container",
        "truck",
        "forklift",
        "crane",
        "car",
        "motorbike",
        "bicycle",
        "person"
      ]
    },
    "VehicleTagLabelEnum": {
      "type": "string",
      "enum": ["known", "unknown"]
    },
    "Point2D": {
      "type": "object",
      "required": ["x", "y"],
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "NormalizedPoint2D": {
      "type": "object",
      "required": ["x", "y"],
      "properties": {
        "x": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "NormalizedBBox": {
      "type": "array",
      "items": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "minItems": 4,
      "maxItems": 4,
      "description": "[x_min, y_min, x_max, y_max] normalized to 0..1"
    },
    "CameraIdAreaOnly": {
      "type": "string",
      "enum": ["BAI-KIEM"]
    },
    "StreamStatusEnum": {
      "type": "string",
      "enum": ["online", "degraded", "offline"]
    },
    "ZoneHit": {
      "type": "object",
      "required": ["zone_id", "zone_name", "rule_result"],
      "properties": {
        "zone_id": {
          "type": "string"
        },
        "zone_name": {
          "type": "string"
        },
        "rule_result": {
          "type": "string",
          "enum": ["allowed", "prohibited", "observed"]
        }
      }
    },
    "AreaDetectedObject": {
      "type": "object",
      "required": ["track_id", "object_class", "confidence", "bbox", "center_point", "zone_hits"],
      "properties": {
        "track_id": {
          "type": "string"
        },
        "object_class": {
          "$ref": "#/definitions/ObjectTypeEnum"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "bbox": {
          "$ref": "#/definitions/NormalizedBBox"
        },
        "center_point": {
          "$ref": "#/definitions/NormalizedPoint2D"
        },
        "zone_hits": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ZoneHit"
          }
        }
      }
    },
    "AreaKpiDelta": {
      "type": "object",
      "required": [
        "area_active_objects",
        "area_zone_violations",
        "area_active_machinery",
        "area_total_zones"
      ],
      "properties": {
        "area_active_objects": {
          "type": "integer",
          "minimum": 0
        },
        "area_zone_violations": {
          "type": "integer",
          "minimum": 0
        },
        "area_active_machinery": {
          "type": "integer",
          "minimum": 0
        },
        "area_total_zones": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "AreaFrameMetadata": {
      "type": "object",
      "required": [
        "camera_id",
        "frame_id",
        "captured_at",
        "zone_version",
        "stream_status",
        "pipeline_latency_ms",
        "objects",
        "kpi_delta"
      ],
      "properties": {
        "camera_id": {
          "$ref": "#/definitions/CameraIdAreaOnly"
        },
        "frame_id": {
          "type": "string"
        },
        "captured_at": {
          "type": "string",
          "format": "date-time"
        },
        "zone_version": {
          "type": "integer",
          "minimum": 1
        },
        "stream_status": {
          "$ref": "#/definitions/StreamStatusEnum"
        },
        "pipeline_latency_ms": {
          "type": "number",
          "minimum": 0
        },
        "objects": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/AreaDetectedObject"
          }
        },
        "kpi_delta": {
          "$ref": "#/definitions/AreaKpiDelta"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "stream_status": {
                "const": "offline"
              }
            },
            "required": ["stream_status"]
          },
          "then": {
            "properties": {
              "objects": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "Zone": {
      "type": "object",
      "required": ["id", "camera_id", "name", "vertices", "allowed_classes", "forbidden_classes", "is_active", "color", "version"],
      "properties": {
        "id": {
          "type": "string"
        },
        "camera_id": {
          "$ref": "#/definitions/CameraIdAreaOnly"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "vertices": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Point2D"
          },
          "minItems": 3,
          "maxItems": 32
        },
        "allowed_classes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ObjectTypeEnum"
          }
        },
        "forbidden_classes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ObjectTypeEnum"
          }
        },
        "is_active": {
          "type": "boolean"
        },
        "color": {
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{6})$"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "ZoneCacheStatus": {
      "type": "object",
      "required": ["camera_id", "zone_version", "cache_status", "refreshed_at"],
      "properties": {
        "camera_id": {
          "$ref": "#/definitions/CameraIdAreaOnly"
        },
        "zone_version": {
          "type": "integer",
          "minimum": 1
        },
        "cache_status": {
          "type": "string",
          "enum": ["hot", "refreshing"]
        },
        "refreshed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "ZoneListResponse": {
      "allOf": [
        {
          "$ref": "#/definitions/ResponseEnvelope"
        },
        {
          "type": "object",
          "properties": {
            "success": {
              "const": true
            },
            "data": {
              "type": "object",
              "required": ["items", "cache"],
              "properties": {
                "items": {
                  "type": "array",
                  "items": {
                    "$ref": "#/definitions/Zone"
                  }
                },
                "cache": {
                  "$ref": "#/definitions/ZoneCacheStatus"
                }
              }
            },
            "error": {
              "type": "null"
            }
          }
        }
      ]
    },
    "ZoneWriteResponse": {
      "allOf": [
        {
          "$ref": "#/definitions/ResponseEnvelope"
        },
        {
          "type": "object",
          "properties": {
            "success": {
              "const": true
            },
            "data": {
              "type": "object",
              "required": ["zone", "cache"],
              "properties": {
                "zone": {
                  "$ref": "#/definitions/Zone"
                },
                "cache": {
                  "$ref": "#/definitions/ZoneCacheStatus"
                }
              }
            },
            "error": {
              "type": "null"
            }
          }
        }
      ]
    }
  }
}
