# SentriAI Mini Environment Configuration Template
# Duplicate this file to .env and adjust variables as needed
#
# Đường dẫn tương đối luôn được tính từ gốc dự án (VisionEdge-AI/),
# không phụ thuộc thư mục chạy lệnh.

# Server Config
HOST=0.0.0.0
PORT=8000

# Database Config
# Canonical local SQLite file; resolved from project root, independent of launch cwd.
# If DATABASE_URL is set, it takes precedence over SENTRIAI_DB_PATH.
SENTRIAI_DB_PATH=backend/db/sentriai.db
# DATABASE_URL=sqlite:///./sentri_ai.db

# Đường dẫn dữ liệu
VIDEOS_DIR=./data/video
IMAGES_DIR=./data/images
CLIPS_DIR=./data/clips
CROPS_DIR=./data/crops

# Ghi đè video cho từng camera (tuỳ chọn).
# Để trống thì dùng ánh xạ mặc định trong backend/app/api/v1/events.py:
#   BAI-KIEM      -> BAI-KIEM.mp4
#   XUONG-AN-NINH -> XUONG-AN-NINH.mp4
#   GATE-01       -> GATE-01.mp4
VIDEO_BAI_KIEM_PATH=
VIDEO_GATE_01_PATH=
VIDEO_XUONG_AN_NINH_PATH=

# AI & Threshold Config
COOLDOWN_DEFAULT_SECONDS=10.0
# Ngưỡng tin cậy tối thiểu của EasyOCR để chấp nhận một chuỗi biển số (REQ-001).
# Dưới ngưỡng thì lượt xe được tính vào KPI "Không đọc được". Camera cổng nhìn xe ở
# góc nghiêng nên biển bị méo phối cảnh, EasyOCR hiếm khi vượt 0.70 dù đọc đúng ký tự.
OCR_CONFIDENCE_THRESHOLD=0.50
# Cửa sổ chống trùng sự kiện LPR_PASSAGE cho cùng một biển số, hợp lệ 10-15 giây.
LPR_COOLDOWN_SECONDS=12

# So lan mot chuoi bien so phai duoc doc ra trong cua so xac nhan thi moi duoc cong
# nhan la mot luot xe. Dat 1 de tat. Recognizer doc sai o vai frame le va sai voi
# confidence cao (do duoc 0.951 / 0.978 / 0.920), nen nguong confidence khong tach
# duoc; so lan lap moi tach duoc. Do o nhip that: bien yeu nhat chi cho 3 phieu, moi
# chuoi ma dung 1 phieu -> muc 2 loai sach ma va van giu bien an toan.
LPR_MIN_CONFIRMATIONS=2
LPR_CONFIRMATION_WINDOW_SECONDS=20.0
# Sàn tin cậy cứng: không biển số nào dưới mức này được lên UI hay vào bảng events, kể
# cả khi đến từ khớp roster.
MIN_ACCEPTED_PLATE_CONFIDENCE=0.50
# Sổ đăng ký biển số thật của các xe trong footage camera cổng, phân tách bằng dấu phẩy.
# Dùng để hoàn thiện lượt đọc dở dang khi biển quá nhỏ; vẫn bắt buộc OCR đọc được ít
# nhất 3 ký tự liên tiếp đúng và kết quả phải vượt sàn trên. Chỉ điền biển đã xác minh.
GATE_PLATE_ROSTER=
# LPR Trigger Box theo zone_id của làn IN: [x, y, w, h] tính theo % khung hình. Ô này
# ngắm sẵn vào tầm biển số ở vị trí xe dừng, để OCR không phải quét cả thân xe.
# Làn không khai báo ở đây sẽ tự lùi về cơ chế quét dải cản va.
GATE_LPR_TRIGGER_BOXES={}
EMBEDDING_SIMILARITY_THRESHOLD=0.82
# Ngưỡng tin cậy tối thiểu của YOLO. Đừng đặt cao hơn ~0.35: đo trên footage thật,
# 0.35 làm bãi Bãi Kiểm rụng từ 4 detection xuống còn 1. Quá thấp thì sinh bbox rác.
DETECTION_CONFIDENCE_THRESHOLD=0.30
# Weights cho Area Zone Monitoring: tên file trong backend/app/ai/weights/
# hoac duong dan tuyet doi. sentri-yolo11s.pt = YOLOv11s finetune 50 epoch
# (9 lop dataset cang). Doi thanh yolov8s-worldv2.pt de quay lai YOLO-World.
DETECTION_MODEL_WEIGHTS=sentri-yolo11s.pt
# Ghi de weights cho tung camera. GATE-01 dung bo khac vi sentri-yolo11s
# gan dau keo can canh thanh 'motorbike' va rong o nhieu frame; do tren clip
# cong, yolov8s-worldv2 tra truck/container 0.45-0.69 deu dan.
DETECTION_MODEL_WEIGHTS_BY_CAMERA={"GATE-01": "yolov8s-worldv2.pt"}
EVENT_COOLDOWN_SECONDS=15

# Multi-channel Alert Config (TASK-011c)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Single Video Path Config (Environment Variable)
VIDEO_PATH=backend\data\videos\BAI_KIEM.mp4
CLIPS_DIR=backend/data/clips

# Google Gemini — nhánh LLM Text-to-SQL của AI Chatbot (ADR-004 / TASK-029).
# Để trống GEMINI_API_KEY thì trợ lý chạy Rule Engine, không gọi mạng.
# Lấy khóa tại https://aistudio.google.com/apikey — KHÔNG commit khóa thật.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
