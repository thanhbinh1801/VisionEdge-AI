# SentriAI Mini Environment Configuration Template
# Duplicate this file to .env and adjust variables as needed

# Server Config
HOST=0.0.0.0
PORT=8000

# Database Config
SENTRIAI_DB_PATH=backend/db/sentriai.db

# AI & Threshold Config
COOLDOWN_DEFAULT_SECONDS=10.0
OCR_CONFIDENCE_THRESHOLD=0.85
EMBEDDING_SIMILARITY_THRESHOLD=0.82

# Multi-channel Alert Config (TASK-011c)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Single Video Path Config (Environment Variable)
VIDEO_PATH=backend\data\videos\BAI_KIEM.mp4

